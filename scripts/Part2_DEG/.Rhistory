RSEM_chytrid <- RSEM_newhope.gene[RSEM_newhope.gene$whichTranscriptome %in% "chytrid",]
RSEM_cyano <- RSEM_newhope.gene[RSEM_newhope.gene$whichTranscriptome %in% "cyano",]
